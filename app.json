{
  "expo": {
    "name": "Vindra",
    "slug": "Vindra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vindra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.woutertm.vindra"
    },
    "android": {
      "package": "com.woutertm.vindra",
      "adaptiveIcon": {
        "backgroundColor": "#12161c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#12161c",
          "dark": {
            "backgroundColor": "#12161c"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Toegang tot de camera is nodig om de koppel-code van je partner te scannen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://bcgwcfaszlmxveaqwzrh.supabase.co",
      "supabaseAnonKey": "sb_publishable_-weaUEygDX4z9oNhKVQqCA_RPGvNlU1",
      "revenuecatIosApiKey": "test_LniOVHomAMQOawlqMGAGsINALxU",
      "revenuecatAndroidApiKey": "test_LniOVHomAMQOawlqMGAGsINALxU"
    }
  }
}
