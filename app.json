{
  "expo": {
    "name": "Vindra",
    "slug": "Vindra",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vindra",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.woutertm.vindra",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "nl": "./languages/nl.json",
      "en": "./languages/en.json",
      "de": "./languages/de.json",
      "es": "./languages/es.json",
      "fr": "./languages/fr.json",
      "pt": "./languages/pt.json"
    },
    "android": {
      "package": "com.woutertm.vindra",
      "adaptiveIcon": {
        "backgroundColor": "#12171C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#12171C",
          "dark": {
            "backgroundColor": "#12171C"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is needed to scan your partner's pairing code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "QuickLog",
              "displayName": "Vindra",
              "description": "Log a moment in one tap, straight from your home screen.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://bcgwcfaszlmxveaqwzrh.supabase.co",
      "supabaseAnonKey": "sb_publishable_-weaUEygDX4z9oNhKVQqCA_RPGvNlU1",
      "revenuecatIosApiKey": "appl_qAXnslTPaNBBUdmVHOWXayIQMSb",
      "revenuecatAndroidApiKey": "test_LniOVHomAMQOawlqMGAGsINALxU",
      "router": {},
      "eas": {
        "projectId": "94d817ec-3474-46ec-ba91-8b53c26134a3",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.woutertm.vindra.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.woutertm.vindra"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
